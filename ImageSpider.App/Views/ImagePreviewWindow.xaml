<Window x:Class="ImageSpider.App.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览" Height="680" Width="920"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="12" Background="#252525" CornerRadius="8">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           MaxWidth="860" MaxHeight="520"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </ScrollViewer>
                <Border Background="#80000000" CornerRadius="4" Padding="12,6"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="加载中..." Foreground="White" FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16,8,16,4">
            <TextBlock Text="{Binding Title}" Foreground="#F0F0F0" FontSize="14"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding ImageUrl}" Foreground="#777777" FontSize="11" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ImageUrl}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#2D2D2D" Padding="12,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="在浏览器打开" Command="{Binding OpenInBrowserCommand}"
                            Padding="14,6" Margin="0,0,8,0" Background="#404040" Foreground="White" BorderThickness="0"/>
                    <Button Content="下载" Command="{Binding DownloadCommand}"
                            Padding="14,6" Margin="0,0,8,0" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                    <Button Content="关闭" IsDefault="True" Click="Close_Click"
                            Padding="14,6" Background="#505050" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Foreground="#999999" VerticalAlignment="Center"
                           Text="{Binding Source, StringFormat=来源: {0}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
