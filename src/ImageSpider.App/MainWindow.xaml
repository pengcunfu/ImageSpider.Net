<Window x:Class="ImageSpider.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ImageSpider.App.ViewModels"
        Title="ImageSpider - 图片搜索" Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="#F5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Padding="10,8" VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"/>
                <Button Grid.Column="1" Content="搜索" Margin="8,0,0,0" Padding="20,8"
                        Command="{Binding SearchCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="API" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                <WrapPanel Grid.Row="1">
                    <CheckBox Content="Bing API" IsChecked="{Binding UseBing}" Margin="0,0,12,6"/>
                    <CheckBox Content="Google" IsChecked="{Binding UseGoogle}" Margin="0,0,12,6"/>
                    <CheckBox Content="Pexels" IsChecked="{Binding UsePexels}" Margin="0,0,12,6"/>
                    <CheckBox Content="Pixabay" IsChecked="{Binding UsePixabay}" Margin="0,0,12,6"/>
                    <CheckBox Content="Unsplash" IsChecked="{Binding UseUnsplash}" Margin="0,0,12,6"/>
                    <TextBlock Text="爬虫" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="8,0,8,6"/>
                    <CheckBox Content="百度" IsChecked="{Binding UseBaidu}" Margin="0,0,12,6"/>
                    <CheckBox Content="360" IsChecked="{Binding UseSo360}" Margin="0,0,12,6"/>
                    <CheckBox Content="搜狗" IsChecked="{Binding UseSogou}" Margin="0,0,12,6"/>
                    <CheckBox Content="必应" IsChecked="{Binding UseBingScrape}" Margin="0,0,12,6"/>
                    <CheckBox Content="DuckDuckGo" IsChecked="{Binding UseDuckDuckGo}" Margin="0,0,12,6"/>
                    <CheckBox Content="安全搜索" IsChecked="{Binding SafeSearch}" Margin="0,0,12,6"/>
                    <Button Content="设置" Command="{Binding OpenSettingsCommand}" Margin="0,0,6,6" Padding="12,4"/>
                    <Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,6,6" Padding="12,4"/>
                    <Button Content="下载选中" Command="{Binding DownloadSelectedCommand}" Margin="0,0,6,6" Padding="12,4"/>
                    <Button Content="加载更多" Command="{Binding LoadMoreCommand}" Margin="0,0,6,6" Padding="12,4"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageItemViewModel}">
                            <Border Width="180" Margin="6" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#EEE" CornerRadius="6,6,0,0" ClipToBounds="True"
                                            Cursor="Hand" ToolTip="点击查看大图"
                                            MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            <TextBlock Text="加载中..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="8,6">
                                        <CheckBox Content="选中" IsChecked="{Binding IsSelected}"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#666"/>
                                        <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#888"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8" Background="#E8EAED" CornerRadius="6">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
